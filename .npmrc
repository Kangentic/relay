# Make package.json's `engines` bound a hard failure rather than a warning.
#
# This is deliberate and load-bearing, not boilerplate. On Node 24 the Vitest
# worker dies on roughly 1 run in 10, taking a whole test file's results with
# it, so `npm test` goes red with nothing having failed. Without this line the
# engines range is only a notice, which is exactly how the pin went unenforced
# long enough for that flake to look mysterious. See docs/testing.md.
#
# The bound is >=20 <23. Docker builds on node:22 and CI runs 20 and 22, so
# every supported path is inside it.
engine-strict=true
