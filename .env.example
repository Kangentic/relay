# Copy to .env and adjust for your deployment. Every variable has a sane
# default in the relay itself; this file documents them and is what
# docker-compose.yml reads by default.

# --- Image: which published tag docker-compose.yml pulls. Defaults to
# `latest`, which tracks the newest commit on main and is not necessarily a
# tagged release; pin a specific release in production. ---
# IMAGE_TAG=v0.1.0

# --- Network ---
PORT=8080
BIND_ADDRESS=0.0.0.0
WS_PATH=/

# --- Slot format (pairing-token-gate proxy for a blind relay) ---
# Accepts the 64-hex pairing slot and the 32-hex ongoing-session slot that
# @kangentic/protocol's deriveSessionSlotId (16 bytes) produces.
#
# SECURITY: this default is load-bearing. A slot id is the only credential
# the relay has, and what makes it unguessable is its 128 or 256 bits of
# entropy - NOT the rate limits below, which cannot bind on an attack that
# tries a different slot id each time. Narrowing this pattern to a short or
# low-entropy shape (say ^[0-9]{6}$) makes slots enumerable no matter how
# tightly everything else is configured. See docs/security-model.md.
SLOT_ID_PATTERN=^([0-9a-f]{32}|[0-9a-f]{64})$

# --- Runaway-bill guards: connection caps ---
# MAX_UNPAIRED_CONNECTIONS bounds connections that have not yet found a
# partner, so a flood of parked sockets cannot consume MAX_CONNECTIONS and
# starve pairings that would otherwise succeed. Leave it unset to derive
# half of MAX_CONNECTIONS. Must be at least 2, since both halves of a pair
# are unpaired at the moment they are admitted.
MAX_CONNECTIONS=10000
# MAX_UNPAIRED_CONNECTIONS=5000
MAX_CONNECTIONS_PER_IP=20
MAX_CONNECTIONS_PER_SLOT=2

# --- Runaway-bill guards: rate limits ---
# These are cost and abuse controls, not the anti-enumeration defense: a
# fresh key starts with a full burst, so the per-slot limiter never binds
# against an attacker guessing a different slot each attempt. Slot entropy
# is what makes guessing hopeless; these keep a single source from being
# expensive.
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_IP_BURST=40
RATE_LIMIT_SLOT_PER_MIN=60
RATE_LIMIT_SLOT_BURST=20

# --- Runaway-bill guards: byte caps ---
# MAX_BUFFERED_BYTES caps how far a slow consumer's outbound socket buffer
# may grow before the tunnel is torn down (close code 4431); it bounds
# worst-case per-connection memory, and both clients reconnect and
# re-handshake by design.
MAX_MESSAGE_BYTES=1114112
MAX_SESSION_BYTES=1073741824
MAX_PARKED_BUFFER_BYTES=1048576
MAX_BUFFERED_BYTES=16777216

# --- Lifecycle ---
PING_INTERVAL_MS=30000
PARK_TIMEOUT_MS=60000
MAX_SESSION_MS=0
SHUTDOWN_GRACE_MS=10000

# --- Real client IP: only enable when a proxy you trust (Cloudflare, Caddy)
# actually fronts this box. TRUSTED_PROXY_CIDRS must name that proxy's
# actual peer address or subnet - the relay refuses to start with
# TRUST_PROXY=true and an empty TRUSTED_PROXY_CIDRS, since that combination
# would trust CF-Connecting-IP / X-Forwarded-For from ANY peer and let a
# client forge either header to bypass every per-IP cap and rate limit
# below. Once a peer is trusted, the relay reads X-Forwarded-For from the
# right (nearest hop first, skipping trusted-proxy hops), not the left, so
# a proxy that appends to the header rather than replacing it is still
# safe. See README.md's "Deploying for real" section. ---
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
IPV6_PREFIX_BITS=64

# --- Metrics: both /metrics and /metricz sit on the same port as the
# WebSocket endpoint, so they are reachable wherever the relay is. They
# carry no slot ids and no IPs, but they do expose live waiting/paired
# gauges and a per-guard reject breakdown, which is useful to an attacker
# tuning against you.
#
# So they require a token: with METRICS_TOKEN empty both surfaces answer
# 404 (not 401, which would advertise that something is there). Generate one
# with `openssl rand -hex 32`. The relay cannot tell from inside the process
# whether it is internet-reachable - in a container BIND_ADDRESS is 0.0.0.0
# either way - so this is a deliberate choice rather than a guess.
#
# Set METRICS_ALLOW_UNAUTHENTICATED=true only for a genuinely private
# deployment (a scrape target on a trusted network, or local development)
# where you would rather not manage a token. ---
METRICS_ENABLED=true
METRICS_TOKEN=
METRICS_ALLOW_UNAUTHENTICATED=false

# --- Logging: no relay log line contains a slot id, raw or hashed. The
# pairing graph (which slot ids co-occur) is sensitive metadata even though
# payloads never are, so the safest handling is not to log it at all, and a
# test enforces that no logger call site passes a slot.
#
# LOG_SLOT_HASHING and SLOT_LOG_SALT configure Logger.slotRef(), the salted
# hash that any future slot logging would have to go through. Nothing calls
# it today, so both are currently inert; they exist so that adding a slot to
# a log line is a deliberate act with a safe default rather than a mistake. ---
LOG_LEVEL=info
LOG_SLOT_HASHING=true
SLOT_LOG_SALT=

# --- Admission (open-core seam): unset means every connection is admitted.
# A private control plane sets this to its own HTTPS endpoint; the relay
# itself never links or imports that plane in-process (see README/AGPL).
#
# NOTE: the shipped binary does not construct this policy. It is a library
# seam for an embedder calling createRelay({ admissionPolicy }); setting the
# variables below on `docker compose up` alone does NOT gate anything.
#
# When a control plane is attached: deny with HTTP 200 and {"allow": false}.
# A 4xx is treated as an explicit deny (it is honored even under
# ADMISSION_FAIL_OPEN); a 5xx, a timeout, or a network error is treated as
# the control plane being unavailable and follows ADMISSION_FAIL_OPEN, which
# defaults to admitting. Set it to false for any entitlement-gated
# deployment. ---
ADMISSION_WEBHOOK_URL=
ADMISSION_WEBHOOK_TIMEOUT_MS=3000
ADMISSION_FAIL_OPEN=true
